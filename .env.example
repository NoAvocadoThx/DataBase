# 复制为 .env 并在启动前 source / 设置为环境变量
SECRET_KEY=用 `openssl rand -hex 32` 生成，至少 32 字符，必填
# 仅在没有 HTTPS 的内网/演示环境才设为 0（Cookie 将允许明文传输）
SECURE_COOKIE=1
# 大模型（OpenAI 兼容接口）。不设则用规则抽取 + 关键词检索
LLM_API_KEY=
LLM_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
# 数据库。留空 = SQLite（DB_PATH，默认 experts.db），本地开发和小规模够用。
# 并发用户多（十几人以上同时打标签/加分组）时改用 PostgreSQL：
# DATABASE_URL=postgresql+psycopg://expert:密码@db:5432/experts
DATABASE_URL=
# 配合 docker compose --profile pg 使用（db 服务的初始化口令，必填）
POSTGRES_PASSWORD=
POSTGRES_USER=expert
POSTGRES_DB=experts
# 连接池（仅 PostgreSQL 生效）：常驻连接数 / 峰值额外连接数
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
